# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se versiona.

# Modelo de faster-whisper para la transcripcion local: tiny, base, small, medium.
STT_MODELO_LOCAL=base

# Servidor de Ollama y modelo para la interpretacion.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Interpretacion por IA: auto (intenta Ollama y cae a las reglas) u off.
NLP_USAR_IA=auto

# Secreto de firma de los tokens de la API.
FINAGOTCHI_SECRET=cambia-esto-en-produccion
