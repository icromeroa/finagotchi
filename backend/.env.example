# Plantilla de configuración. Copia los nombres de variable, NO la clave.
#
# AVISO IMPORTANTE:
# Este archivo SÍ está versionado en git. Nunca escribas aquí una API key real.
# La clave de Gemini vive fuera del repositorio, en:
#     %USERPROFILE%\.finagotchi\gemini.env
# y se crea con:  py -3 tools/configurar_api_key.py
#
# Si necesitas un .env dentro del proyecto (ignorado por git), créalo con:
#     Copy-Item backend/.env.example backend\.env

# API key de Gemini (https://aistudio.google.com -> Get API key). Déjala vacía aquí.
GEMINI_API_KEY=

# Modelo de Gemini usado para transcribir el audio.
GEMINI_MODEL=gemini-3.5-flash

# Modelos alternativos cuando el principal no está disponible.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.8-flash

# Tiempo maximo de espera de una llamada de transcripcion, en segundos.
GEMINI_TIMEOUT_S=60

# Tiempo maximo total de todos los reintentos, en segundos.
GEMINI_PLAZO_S=90

# Secreto de firma de los tokens de la API. Cambialo en produccion.
FINAGOTCHI_SECRET=cambia-esto-en-produccion
