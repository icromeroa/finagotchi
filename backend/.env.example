# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se versiona.

# API key de Gemini (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Modelo de Gemini usado para transcribir el audio.
GEMINI_MODEL=gemini-3.5-flash

# Modelos alternativos cuando el principal no esta disponible.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.8-flash

# Tiempo maximo de espera de una llamada de transcripcion, en segundos.
GEMINI_TIMEOUT_S=60

# Tiempo maximo total de todos los reintentos, en segundos.
GEMINI_PLAZO_S=90

# Proveedor de transcripcion: auto (Gemini y, si falla, el modelo local),
# gemini (solo la API de Google) o local (solo faster-whisper en el PC).
STT_PROVEEDOR=auto

# Modelo de faster-whisper para el proveedor local: tiny, base, small, medium.
STT_MODELO_LOCAL=base

# Proveedor del modelo de lenguaje que interpreta la frase: auto (Ollama si
# esta, si no Gemini), ollama o gemini.
LLM_PROVEEDOR=auto

# Servidor de Ollama y modelo para la interpretacion.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Interpretacion por IA: auto (intenta el LLM y cae a las reglas) u off.
NLP_USAR_IA=auto

# Secreto de firma de los tokens de la API.
FINAGOTCHI_SECRET=cambia-esto-en-produccion
