# Configuración mínima de Xiaozhi — plantilla (sin secretos)
#
# Copiar como:  C:\Users\ASUS\xiaozhi-server\data\.config.yaml
# y rellenar las claves. Nunca subir este archivo con claves a Git.
# Ver docs/INSTALL_XIAOZHI.md y docs/CONFIG_XIAOZHI.md

server:
  ip: 0.0.0.0
  port: 8000
  http_port: 8003
  websocket: ws://192.168.1.20:8000/xiaozhi/v1/
  vision_explain: http://192.168.1.20:8003/mcp/vision/explain
  timezone_offset: -5

log:
  log_level: INFO

prompt: |
  Eres Nancy, asistente de voz de FinaGotchi, finanzas personales en español de Latinoamérica.
  Nunca decides montos, fechas ni confirmaciones.
  Para cualquier gasto, ingreso, ahorro, meta o consulta financiera, llama a finagotchi_turno con la frase textual del usuario.
  Di literalmente el campo "respuesta" del resultado y no inventes cifras.
  Si "requiere_confirmacion" es true, espera la respuesta natural (sí/no/cancela/corrección) y vuelve a llamar a finagotchi_turno.

prompt_template: agent-base-prompt.txt

selected_module:
  VAD: SileroVAD
  ASR: GroqASR
  LLM: GroqLLM
  VLLM: ChatGLMVLLM
  TTS: EdgeTTS
  Memory: nomem
  Intent: function_call

Intent:
  function_call:
    type: function_call
    functions:
      - change_role
      - web_search
      - get_weather
      - get_news_from_newsnow
      - play_music

Memory:
  nomem:
    type: nomem

ASR:
  GroqASR:
    type: openai
    api_key: "TU_GROQ_API_KEY"
    base_url: "https://api.groq.com/openai/v1/audio/transcriptions"
    model_name: "whisper-large-v3-turbo"
    output_dir: tmp/
  OpenaiASR:
    type: openai
    api_key: "TU_OPENAI_API_KEY"
    base_url: "https://api.openai.com/v1/audio/transcriptions"
    model_name: "gpt-4o-mini-transcribe"
    output_dir: tmp/
  FunASR:
    type: fun_local
    model_dir: models/SenseVoiceSmall
    output_dir: tmp/
    language: auto

VAD:
  SileroVAD:
    type: silero
    threshold: 0.5
    threshold_low: 0.3
    model_dir: models/snakers4_silero-vad
    min_silence_duration_ms: 200

LLM:
  GroqLLM:
    type: openai
    api_key: "TU_GROQ_API_KEY"
    base_url: "https://api.groq.com/openai/v1"
    model_name: "llama-3.3-70b-versatile"
    temperature: 0.7
    max_tokens: 500
  ChatGLMLLM:
    type: openai
    model_name: glm-4-flash
    url: https://open.bigmodel.cn/api/paas/v4/
    api_key: "TU_ZHIPU_API_KEY"

VLLM:
  ChatGLMVLLM:
    type: openai
    model_name: glm-4v-flash
    url: https://open.bigmodel.cn/api/paas/v4/
    api_key: "TU_ZHIPU_API_KEY"

TTS:
  # Primera pasada: sin clave, voz es-MX
  EdgeTTS:
    type: edge
    voice: es-MX-DaliaNeural
    output_dir: tmp/
  # Voz de Nancy (Piper) vía puente. host.docker.internal = Windows host.
  FinaGotchiTTS:
    type: custom
    method: POST
    url: "http://host.docker.internal:5000/api/v1/device/voice/synthesize"
    params:
      texto: "{prompt_text}"
    headers:
      Content-Type: "application/json"
      X-Device-Token: "TU_DEVICE_TOKEN"

wakeup_words:
  - "你好小智"
  - "小爱同学"

# La URL MCP se confirma con los logs de arranque. Ver docs/END_TO_END.md
# mcp_endpoint: ws://TU_IP:8004/mcp_endpoint/mcp/?token=TU_TOKEN (solo full install)
